{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 1,
      "settings": {
        "onlyCategories": ["accessibility", "best-practices", "seo"],
        "skipAudits": ["uses-http2"]
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.80 }],
        "categories:best-practices": ["warn",  { "minScore": 0.75 }],
        "categories:seo":            ["warn",  { "minScore": 0.70 }],

        "color-contrast":            ["error", { "minScore": 1 }],
        "image-alt":                 ["error", { "minScore": 1 }],
        "label":                     ["error", { "minScore": 1 }],
        "link-name":                 ["error", { "minScore": 1 }],
        "button-name":               ["error", { "minScore": 1 }],
        "aria-required-attr":        ["error", { "minScore": 1 }],
        "aria-valid-attr":           ["error", { "minScore": 1 }],
        "aria-valid-attr-value":     ["error", { "minScore": 1 }],
        "document-title":            ["warn",  { "minScore": 1 }],
        "html-has-lang":             ["warn",  { "minScore": 1 }],
        "meta-viewport":             ["warn",  { "minScore": 1 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
